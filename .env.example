# ---- Shared ----
NODE_ENV=development

# ---- Database ----
DATABASE_URL=postgres://clipper:clipper@localhost:5432/clipper

# ---- Redis / BullMQ ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- API server ----
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000

# Session auth (MVP1 single-user). Generate a random 32+ char string for SESSION_SECRET.
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
# bcrypt hash of the admin password - generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=

# ---- Storage (local filesystem for MVP1) ----
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
# Max upload size in bytes (default 2GB)
UPLOAD_MAX_BYTES=2147483648

# ---- Clip generation tuning ----
# Target clip length range, in seconds
CLIP_MIN_DURATION_SECONDS=15
CLIP_MAX_DURATION_SECONDS=60
# How many clips to aim for per source video
CLIP_TARGET_COUNT_MIN=7
CLIP_TARGET_COUNT_MAX=10
# ffmpeg silencedetect tuning - noise floor in dB (negative, e.g. -30) and
# minimum silence duration in seconds before it counts as a cut boundary
SILENCE_NOISE_DB=-30
SILENCE_MIN_DURATION_SECONDS=0.5
# How far (seconds) a candidate cut point may snap to the nearest detected
# silence boundary before falling back to a fixed-interval cut
SILENCE_SNAP_WINDOW_SECONDS=5

# ---- ffmpeg ----
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Hard timeout per ffmpeg/ffprobe invocation, in milliseconds
FFMPEG_TIMEOUT_MS=600000

# ---- Cleanup ----
# Delete source videos + clips older than this many days
CLEANUP_RETENTION_DAYS=7
# Cron expression for the cleanup repeatable job
CLEANUP_CRON=0 3 * * *

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
