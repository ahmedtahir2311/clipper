# ---- Shared ----
NODE_ENV=development

# ---- Redis / BullMQ ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- API server ----
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000

# ---- Storage (local filesystem) ----
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
# Max upload size in bytes (default 2GB)
UPLOAD_MAX_BYTES=2147483648

# ---- Clip generation tuning ----
# Target clip length range, in seconds
CLIP_MIN_DURATION_SECONDS=15
CLIP_MAX_DURATION_SECONDS=60
# How many clips to aim for per source video
CLIP_TARGET_COUNT_MIN=7
CLIP_TARGET_COUNT_MAX=10
# ffmpeg silencedetect tuning - noise floor in dB (negative, e.g. -30) and
# minimum silence duration in seconds before it counts as a cut boundary
SILENCE_NOISE_DB=-30
SILENCE_MIN_DURATION_SECONDS=0.5
# How far (seconds) a candidate cut point may snap to the nearest detected
# silence boundary before falling back to a fixed-interval cut
SILENCE_SNAP_WINDOW_SECONDS=5

# ---- ffmpeg ----
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Hard timeout per ffmpeg/ffprobe invocation, in milliseconds
FFMPEG_TIMEOUT_MS=600000

# ---- YouTube URL import ----
# Requires yt-dlp on PATH (pip install yt-dlp, or download the standalone
# binary). Only import videos you own or have the rights to clip.
YT_DLP_PATH=yt-dlp
# Timeout for the metadata probe (title/duration) done synchronously when a
# URL is submitted, in milliseconds. yt-dlp's own startup + YouTube's
# signature/token extraction commonly takes 10-30s on a cold start, so don't
# set this too low - raise it further if imports keep timing out.
YT_DLP_METADATA_TIMEOUT_MS=45000
# Timeout for the actual video download, run in the worker, in milliseconds
YT_DLP_DOWNLOAD_TIMEOUT_MS=1800000
# Reject imports longer than this, in seconds (default 2 hours)
YOUTUBE_IMPORT_MAX_DURATION_SECONDS=7200

# ---- Cleanup ----
# Delete source videos + clips older than this many days
CLEANUP_RETENTION_DAYS=7
# Cron expression for the cleanup repeatable job
CLEANUP_CRON=0 3 * * *

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
